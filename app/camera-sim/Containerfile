FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

# ffmpeg is not in the UBI repos; the RPM Fusion free build is the usual source.
RUN microdnf install -y --nodocs tar xz procps-ng \
 && microdnf clean all \
 && ARCH=$(uname -m) \
 && curl -fsSL "https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-${ARCH}-static.tar.xz" \
      -o /tmp/ffmpeg.tar.xz \
 && tar -xJf /tmp/ffmpeg.tar.xz -C /tmp \
 && mv /tmp/ffmpeg-*-static/ffmpeg /usr/local/bin/ffmpeg \
 && mv /tmp/ffmpeg-*-static/ffprobe /usr/local/bin/ffprobe \
 && rm -rf /tmp/ffmpeg*

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
COPY make-sample-video.sh /usr/local/bin/make-sample-video.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh /usr/local/bin/make-sample-video.sh

# OpenShift assigns an arbitrary uid; nothing here needs a real user.
USER 1001
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
