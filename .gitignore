# Secrets and per-user configuration
config/instance.env
config/pull-secret.json
config/*.pem
config/*.key

# Generated state
deploy/aws-infra/instance-data/
deploy/openshift-clusters/inventory.ini
deploy/openshift-clusters/inventory.ini.*
# Cluster credentials fetched by 'make kubeconfig' -- kubeconfigs for the hub
# and every guest cluster, plus the kubeadmin password. The path below it was
# the original rule and guarded a directory nothing ever wrote to; the real
# destination is deploy/clusters/, which was consequently unprotected.
deploy/clusters/
deploy/openshift-clusters/clusters/
logs/*
!logs/.gitkeep

# Installer artifacts
*.ign
auth/
metadata.json
.openshift_install*

# Installed by 'ansible-galaxy collection install -r collections/requirements.yml'
deploy/openshift-clusters/collections/ansible_collections/

# Python bytecode
__pycache__/
*.pyc
