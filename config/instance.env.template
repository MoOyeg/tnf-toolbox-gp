# Copy to config/instance.env and edit. That file is gitignored.
#   cp config/instance.env.template config/instance.env

# ---------------------------------------------------------------- AWS
export AWS_PROFILE=default
export REGION=us-west-2
export AWS_DEFAULT_REGION="${REGION}"

# g4dn.metal capacity is uneven across AZs and it is not offered in every one.
# Confirm before you set this:
#   aws ec2 describe-instance-type-offerings --location-type availability-zone \
#     --filters Name=instance-type,Values=g4dn.metal --region "$REGION" \
#     --query 'InstanceTypeOfferings[].Location' --output text
export AVAILABILITY_ZONE=us-west-2a

# ---------------------------------------------------------------- Cluster
export CLUSTER_NAME=tnf-gp

# Leave empty to use the account's public Route53 zone automatically. The zone
# name is issued per account, so hard-coding it means editing this file on every
# new account. Set it explicitly only when the account has more than one public
# zone. The cluster ends up at <CLUSTER_NAME>.<BASE_DOMAIN>, publicly resolvable,
# with certificates the installer issues for that exact name -- so oc needs
# neither /etc/hosts entries nor --insecure-skip-tls-verify.
export BASE_DOMAIN=
export OCP_VERSION=4.22.0

# Empty on purpose for 4.22, where two-node fencing is GA -- `openshift-install
# create manifests` accepts controlPlane.fencing.credentials with no feature set
# at all. Set it to TechPreviewNoUpgrade only on 4.21 or older.
#
# Do not set it "just in case" on 4.22. TechPreviewNoUpgrade enables the
# ClusterAPIMachineManagement gate, which creates
# clusterapis.operator.openshift.io. HyperShift's installer sees that API and
# waits for the Cluster CAPI Operator to sync -- and on platform:none that
# operator is a no-op ("MachineAPIMigration not implemented for platform None"),
# so it never syncs. The HyperShift operator is then never installed, no CRDs
# appear, and every guest cluster fails with "no matches for kind HostedCluster".
# The feature set is also irreversible: fixing it means reinstalling.
export FEATURE_SET=

# ---------------------------------------------------------------- Instances
export MASTER_INSTANCE_TYPE=g4dn.metal   # 96 vCPU, 384 GiB, 8x Tesla T4
export BOOTSTRAP_INSTANCE_TYPE=m5.xlarge
export BASTION_INSTANCE_TYPE=m5.large
export ROOT_VOLUME_GIB=200
export DATA_VOLUME_GIB=500               # EBS gp3 per node, backs LVM Storage

# ---------------------------------------------------------------- Network
export VPC_CIDR=10.0.0.0/16
export SUBNET_CIDR=10.0.0.0/24
export BASTION_PRIVATE_IP=10.0.0.5       # fixed: the fencing address embeds it
export BOOTSTRAP_PRIVATE_IP=10.0.0.9
export MASTER0_PRIVATE_IP=10.0.0.10
export MASTER1_PRIVATE_IP=10.0.0.11

# SSH to the bastion. Narrow this to your own address.
export ALLOWED_SSH_CIDR=0.0.0.0/0

# The cluster API and ingress. Open by default, because a publicly resolvable
# cluster that nothing can reach is not much use -- narrow it if you want the
# names public but the endpoints restricted. Kept separate from
# ALLOWED_SSH_CIDR so exposing the API never widens SSH.
export ALLOWED_API_CIDR=0.0.0.0/0

# ---------------------------------------------------------------- Credentials
export SSH_KEY_NAME=my-ec2-keypair                    # existing EC2 key pair
export SSH_PRIVATE_KEY="${HOME}/.ssh/id_ed25519"      # its private half
export SSH_PUBLIC_KEY="${HOME}/.ssh/id_ed25519.pub"
# Resolved relative to this file, so it works regardless of where you run make.
export PULL_SECRET_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/pull-secret.json"

# Credentials the Redfish shim requires and Pacemaker fences with. These end up
# in install-config.yaml and in a cluster secret; treat them as a real password.
export BMC_USERNAME=admin
export BMC_PASSWORD=CHANGE-ME

# ---------------------------------------------------------------- ACM site
# ACM runs at its own site: a separate VPC, its own bastion, and a single-node
# OpenShift cluster on bare metal. The two sites are joined by VPC peering, and
# ACM reaches the MultiCluster Engine on TNF across it.
#
# Bare metal because the ACM cluster runs OpenShift Virtualization, which needs
# KVM -- unavailable on a normal EC2 instance. m5zn.metal is the cheapest x86
# metal that fits; no GPU is needed here.
#
# The CIDRs must not overlap TNF's. Peering will not route between VPCs whose
# address ranges collide, and AWS rejects the connection outright.
export ACM_CLUSTER_NAME=acm
export ACM_VPC_CIDR=10.1.0.0/16
export ACM_SUBNET_CIDR=10.1.0.0/24
export ACM_BASTION_PRIVATE_IP=10.1.0.5
export ACM_SNO_PRIVATE_IP=10.1.0.10
export ACM_SNO_INSTANCE_TYPE=m5zn.metal     # 48 vCPU, 192 GiB, bare metal
export ACM_SNO_ROOT_VOLUME_GIB=200
export ACM_SNO_DATA_VOLUME_GIB=300          # LVM Storage for ACM and hosted etcd

# Defaults to the TNF availability zone. They need not match -- peering works
# across AZs -- but same-AZ traffic avoids cross-AZ data charges.
export ACM_AVAILABILITY_ZONE="${AVAILABILITY_ZONE}"

# ---------------------------------------------------------------- GPU layout
# g4dn.metal has 8 Tesla T4s per node. The NVIDIA GPU Operator assigns a whole
# node to one mode: 'container' binds its GPUs to the NVIDIA driver for pods,
# 'vm-passthrough' binds them to vfio-pci for KubeVirt VMs. There is no
# supported per-GPU split within a node, so the split is per node.
#
# The default gives the base cluster real GPU compute on one node and 8 T4s for

# ---------------------------------------------------------------- Guest clusters
# Which driver each node's GPUs are bound to. The GPU Operator decides this per
# node -- its driver container unbinds vfio-pci from every device on a node it
# manages, so a node cannot serve both. Both are vm-passthrough here, which puts
# all sixteen T4s behind KubeVirt and lets a guest's workers spread across both
# machines. Flip one to 'container' to get GPU pods on the base cluster instead.
export MASTER0_GPU_WORKLOAD=vm-passthrough
export MASTER1_GPU_WORKLOAD=vm-passthrough

export GUEST_CLUSTER_COUNT=1
export GUEST_CLUSTER_PREFIX=vcp
export GUEST_NODEPOOL_REPLICAS=3        # KubeVirt worker VMs per guest cluster
export GUEST_GPUS_PER_NODE=2            # T4s passed into each worker VM
export GUEST_VM_CORES=8
export GUEST_VM_MEMORY=32Gi
export GUEST_VM_ROOT_DISK=64Gi
