#
# Ansible managed -- roles/vcp-cluster/templates/clusterinstance.yaml.j2
#
# Site definition for {{ vcp_cluster_name }}: a whole OpenShift cluster whose
# every node is a virtual machine on the infra cluster.
#
# This file is the *what* -- name, domain, networks. The *how* is
# {{ siteconfig_vcp_cluster_template }}, which renders the ClusterDeployment,
# AgentClusterInstall, InfraEnv, ManagedCluster and KlusterletAddonConfig this
# cluster is installed from.
apiVersion: siteconfig.open-cluster-management.io/v1alpha1
kind: ClusterInstance
metadata:
  name: {{ vcp_cluster_name }}
  namespace: {{ vcp_cluster_name }}
spec:
  clusterName: {{ vcp_cluster_name }}
  baseDomain: {{ base_domain }}
  # Three control-plane VMs carrying their own etcd quorum. Not SNO, and not a
  # hosted control plane: nothing of this cluster runs on the hub.
  clusterType: HighlyAvailable
  clusterImageSetNameRef: openshift-{{ ocp_version }}
  networkType: OVNKubernetes
  pullSecretRef:
    name: {{ vcp_cluster_name }}-pull-secret
  sshPublicKey: "{{ ssh_public_key }}"
  clusterNetwork:
    - cidr: {{ vcp_cluster_network_cidr }}
      hostPrefix: {{ cluster_network_host_prefix }}
  serviceNetwork:
    - cidr: {{ vcp_service_network_cidr }}
  templateRefs:
    - name: {{ siteconfig_vcp_cluster_template }}
      namespace: {{ siteconfig_template_namespace }}
  # Every node has to be listed, and the operator's own validation is why:
  #
  #   controlPlaneCount < 1 && clusterType != HostedControlPlane
  #     -> "at least 1 control-plane agent is required"
  #
  # An empty list is accepted by the CRD schema and then rejected at reconcile,
  # which is a quiet way to fail -- the Application syncs green and the cluster
  # never appears.
  #
  # So each VM is declared, and three of its required fields are fictions:
  # a NodeSpec is written for hardware to be *claimed*, and these VMs do not
  # exist until the infra cluster creates them. bmcAddress points into TEST-NET-1
  # (RFC 5737, reserved for documentation) so that anything which does try to
  # dial it fails immediately and visibly rather than reaching something real;
  # the boot MAC is locally administered and is not the address KubeVirt will
  # assign; and the credentials Secret exists only because the validator checks
  # that it does. None is ever read, because the node template set renders no
  # BareMetalHost for them to be read by.
  nodes:
{% for i in range(1, vcp_control_plane_replicas | int + 1) %}
    - hostName: "{{ vcp_cluster_name }}-cp-{{ i }}"
      role: master
      bmcAddress: "redfish-virtualmedia://192.0.2.1/redfish/v1/Systems/{{ vcp_cluster_name }}-cp-{{ i }}"
      bmcCredentialsName:
        name: {{ vcp_cluster_name }}-bmc-placeholder
      bootMACAddress: "02:00:00:00:00:{{ '%02x' | format(i) }}"
      templateRefs:
        - name: {{ siteconfig_vcp_node_template }}
          namespace: {{ siteconfig_template_namespace }}
{% endfor %}
