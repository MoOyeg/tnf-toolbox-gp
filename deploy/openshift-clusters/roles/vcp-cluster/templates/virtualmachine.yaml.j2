apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: {{ vm.name }}
  namespace: {{ vcp_vm_namespace }}
  labels:
    tnf-toolbox-gp/cluster: {{ vcp_cluster_name }}
    tnf-toolbox-gp/role: {{ vm.role }}
spec:
  running: true
  dataVolumeTemplates:
    - metadata:
        name: {{ vm.name }}-root
      spec:
        storage:
          accessModes: [ReadWriteOnce]
          resources:
            requests:
              storage: {{ vcp_root_disk }}
          storageClassName: {{ storage_class }}
        source:
          blank: {}
    - metadata:
        name: {{ vm.name }}-data
      spec:
        storage:
          accessModes: [ReadWriteOnce]
          resources:
            requests:
              storage: {{ vcp_data_disk }}
          storageClassName: {{ storage_class }}
        source:
          blank: {}
  template:
    metadata:
      labels:
        kubevirt.io/domain: {{ vm.name }}
        # On the pod template as well as on the VirtualMachine above. A Service
        # selects pods, and the virt-launcher pod inherits these labels rather
        # than the VM object's -- so expose.yml's Services matched nothing, and
        # the NodePort listened with no backend and refused every connection.
        tnf-toolbox-gp/cluster: {{ vcp_cluster_name }}
        tnf-toolbox-gp/role: {{ vm.role }}
    spec:
      # Spread these across the infra cluster's nodes rather than letting them
      # pile onto whichever one has room first. maxSkew 1 asks for as even a
      # distribution as the node count allows, and ScheduleAnyway keeps this one
      # a preference: a VM that cannot be placed evenly is still placed, which
      # matters on a two-node infra cluster where losing a node would otherwise
      # leave VMs Pending rather than merely unbalanced.
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              tnf-toolbox-gp/cluster: {{ vcp_cluster_name }}
        # And again over the machines sharing this one's role, as a requirement.
        # The constraint above balances the cluster as a whole, which an even
        # split satisfies with every master on one infra node and every worker
        # on the other -- losing a node would take the entire control plane, and
        # the cluster would have scheduled cleanly on its way there. Per role,
        # maxSkew 1 over two infra nodes admits 2/1 for three masters and 1/1
        # for two workers.
        #
        # This is only worth anything because each machine now boots a discovery
        # volume of its own. While they shared one, that volume was ReadWriteOnce
        # on node-local storage -- a hard constraint no preference here could
        # beat, and one this requirement would now simply deadlock against.
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: DoNotSchedule
          labelSelector:
            matchLabels:
              tnf-toolbox-gp/cluster: {{ vcp_cluster_name }}
              tnf-toolbox-gp/role: {{ vm.role }}
      # A node that reboots into its installed disk must not be handed the
      # discovery ISO again, so the disk is first in the boot order and the
      # cdrom second. Ignoring this gets a cluster that installs and then
      # rediscovers itself forever.
      domain:
        cpu:
          cores: {{ vm.cores }}
        memory:
          guest: {{ vm.memory }}
        devices:
          disks:
            - name: root
              bootOrder: 1
              disk:
                bus: virtio
            - name: discovery
              bootOrder: 2
              cdrom:
                bus: sata
                readonly: true
            # No bootOrder: it must never be booted from. This is the blank
            # disk LVM Storage builds the cluster's storage class on, and a
            # device LVM owns carries no bootable filesystem.
            - name: data
              disk:
                bus: virtio
          interfaces:
            # The l2bridge binding plugin, not masquerade. Masquerade NATs the
            # guest behind the pod and hands every VM the same 10.0.2.2, so a
            # multi-node cluster registers three copies of one address and never
            # forms. This attaches the VM to the namespace's primary UDN, where
            # it gets an address of its own and keeps it across a reboot.
            - name: default
              binding:
                name: l2bridge
{% if vm.gpus | int > 0 %}
          hostDevices:
{% for i in range(vm.gpus | int) %}
            - name: gpu{{ i + 1 }}
              deviceName: {{ gpu_resource_name }}
{% endfor %}
{% endif %}
      networks:
        - name: default
          pod: {}
      volumes:
        - name: root
          dataVolume:
            name: {{ vm.name }}-root
        - name: discovery
          dataVolume:
            name: {{ vm.name }}-discovery
        - name: data
          dataVolume:
            name: {{ vm.name }}-data
      # An assisted install reboots each node when it writes the image to disk;
      # without this KubeVirt treats the reboot as a crash and restarts the VM
      # from the ISO instead.
      terminationGracePeriodSeconds: 180
