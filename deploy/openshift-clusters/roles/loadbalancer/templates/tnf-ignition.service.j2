[Unit]
Description=Ignition config server for this site's bootstrap node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{ ignition_root }}
ExecStart=/usr/bin/python3 -m http.server {{ ignition_port }} --bind {{ lb_bind_address }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
