# The ACM cluster: single-node OpenShift on its own bare-metal EC2 instance, at
# the ACM site.
#
# One control-plane replica and no compute is the SNO shape. bootstrapInPlace is
# deliberately absent: with it, `create single-node-ignition-config` emits only
# bootstrap-in-place-for-live-iso.ign, which expects to run from the RHCOS live
# ISO. Without it the normal flow emits bootstrap.ign plus a small master.ign --
# exactly what the TNF nodes already boot from an AMI with an ignition pointer in
# user-data, so the ACM cluster reuses that machinery instead of needing an ISO.
#
# Bare metal because this cluster runs OpenShift Virtualization, which needs KVM.
apiVersion: v1
baseDomain: {{ base_domain }}
metadata:
  name: {{ acm_cluster_name }}
controlPlane:
  name: master
  replicas: 1
compute:
  - name: worker
    replicas: 0
networking:
  networkType: {{ network_type }}
  machineNetwork:
    - cidr: {{ acm_subnet_cidr }}
  clusterNetwork:
    - cidr: {{ cluster_network_cidr }}
      hostPrefix: {{ cluster_network_host_prefix }}
  serviceNetwork:
    - {{ service_network_cidr }}
platform:
  none: {}
pullSecret: '{{ pull_secret }}'
sshKey: '{{ ssh_public_key }}'
