---
# Reachability for the SNO's API and ingress.
#
# The VM sits behind masquerade NAT on the pod network, so nothing outside the
# TNF cluster can address it directly. These Services give it stable NodePorts;
# the bastion's haproxy then routes to them, and DNS points at the bastion. That
# reuses the path the TNF cluster's own API already takes rather than inventing
# a second one.
apiVersion: v1
kind: Service
metadata:
  name: {{ sno_vm_name }}-api
  namespace: {{ sno_namespace }}
spec:
  type: NodePort
  selector:
    kubevirt.io/domain: {{ sno_vm_name }}
  ports:
    - name: api
      port: 6443
      targetPort: 6443
      nodePort: {{ sno_api_nodeport }}
      protocol: TCP
---
apiVersion: v1
kind: Service
metadata:
  name: {{ sno_vm_name }}-ingress
  namespace: {{ sno_namespace }}
spec:
  type: NodePort
  selector:
    kubevirt.io/domain: {{ sno_vm_name }}
  ports:
    - name: https
      port: 443
      targetPort: 443
      nodePort: {{ sno_https_nodeport }}
      protocol: TCP
    - name: http
      port: 80
      targetPort: 80
      nodePort: {{ sno_http_nodeport }}
      protocol: TCP
