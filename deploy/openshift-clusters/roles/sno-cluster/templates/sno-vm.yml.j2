---
# The SNO cluster's single node, as a KubeVirt VM on TNF.
#
# Two disks: a blank root the agent installer writes RHCOS onto, and the agent
# ISO as a cdrom. Boot order puts the cdrom first so the installer runs; once
# RHCOS is on disk the installer stops the VM, and the run task restarts it with
# the cdrom detached so it boots what was installed.
apiVersion: cdi.kubevirt.io/v1beta1
kind: DataVolume
metadata:
  name: {{ sno_vm_name }}-iso
  namespace: {{ sno_namespace }}
spec:
  source:
    http:
      # Served by the bastion's existing ignition HTTP server. Pods egress via
      # the node, whose address is inside the VPC CIDR the bastion's security
      # group already admits.
      url: "{{ ignition_base_url }}/{{ sno_iso_name }}"
  storage:
    resources:
      requests:
        storage: 8Gi
    storageClassName: {{ storage_class }}
---
apiVersion: cdi.kubevirt.io/v1beta1
kind: DataVolume
metadata:
  name: {{ sno_vm_name }}-root
  namespace: {{ sno_namespace }}
spec:
  source:
    blank: {}
  storage:
    resources:
      requests:
        storage: {{ sno_disk }}
    storageClassName: {{ storage_class }}
---
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: {{ sno_vm_name }}
  namespace: {{ sno_namespace }}
  labels:
    app: {{ sno_vm_name }}
spec:
  running: true
  template:
    metadata:
      labels:
        # The Services below select on this.
        kubevirt.io/domain: {{ sno_vm_name }}
        app: {{ sno_vm_name }}
    spec:
      # The ACM hub must not land on the node whose GPUs are bound to vfio-pci
      # and reserved for guest cluster workers.
      nodeSelector:
        "{{ gpu_device_label }}": container
      domain:
        cpu:
          cores: {{ sno_vcpus }}
        memory:
          guest: {{ sno_memory }}
        devices:
          disks:
            - name: rootdisk
              disk:
                bus: virtio
              bootOrder: 2
            - name: installiso
              cdrom:
                bus: sata
              bootOrder: 1
          interfaces:
            - name: default
              masquerade: {}
              model: virtio
        resources:
          requests:
            memory: {{ sno_memory }}
      networks:
        - name: default
          pod: {}
      terminationGracePeriodSeconds: 180
      volumes:
        - name: rootdisk
          dataVolume:
            name: {{ sno_vm_name }}-root
        - name: installiso
          dataVolume:
            name: {{ sno_vm_name }}-iso
