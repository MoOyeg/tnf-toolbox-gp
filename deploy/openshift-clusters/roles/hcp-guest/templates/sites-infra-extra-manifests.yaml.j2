#
# Ansible managed -- roles/hcp-guest/templates/sites-infra-extra-manifests.yaml.j2
#
# Install-time node configuration for {{ guest_name }}, referenced from the
# NodePool via spec.config.
#
# The same manifest the hub-hosted profile writes, in the namespace the
# HostedCluster actually lives in on the infra cluster. A NodePool's config
# ConfigMap is resolved in the HostedCluster's own namespace, so this has to
# follow the cluster rather than stay behind on the hub.
#
# The shape is fixed by HyperShift: a NodePool config entry is a ConfigMap
# holding exactly one manifest under the key 'config', where the assisted
# installer's takes many keyed by filename. One ConfigMap per manifest is the
# cost of that.
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ guest_name }}-chrony
  namespace: {{ hcp_namespace }}
  annotations:
    # Before the NodePool that references it.
    argocd.argoproj.io/sync-wave: "0"
data:
  config: |
    apiVersion: machineconfiguration.openshift.io/v1
    kind: MachineConfig
    metadata:
      name: {{ guest_chrony_machine_config_name }}
      labels:
        machineconfiguration.openshift.io/role: worker
    spec:
      config:
        ignition:
          version: 3.2.0
        storage:
          files:
            - path: /etc/chrony.conf
              mode: 420
              overwrite: true
              contents:
                source: data:text/plain;charset=utf-8;base64,{{ guest_chrony_conf | b64encode }}
