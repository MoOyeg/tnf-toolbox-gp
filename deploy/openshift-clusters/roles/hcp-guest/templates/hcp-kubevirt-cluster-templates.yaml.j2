#
# Ansible managed -- roles/siteconfig/templates/hcp-kubevirt-cluster-templates.yaml.j2
#
# Cluster-level install templates for a hosted control plane whose workers are
# KubeVirt VMs: the control plane runs as pods on this hub, the VMs run on the
# infra cluster across the peering connection.
#
# Why this is not hcp-cluster-templates-v1, the hosted-cluster set that ships
# with the operator: that set renders HostedCluster and NodePool with
# `platform: type: Agent`, one NodePool of `replicas: 1` per entry in
# spec.nodes, each bound to a BareMetalHost by label. That is hosted control
# planes on bare metal. Ours are on OpenShift Virtualization, where the workers
# are VMs HyperShift creates itself from a NodePool replica count and there is
# no host, no BMC and no Agent anywhere in the flow.
#
# spec.nodes is therefore empty in every site definition that uses this set.
# The field is required by the ClusterInstance API but carries no minimum, and
# the validator only walks the list -- an empty one renders no node manifests,
# which is exactly right when the nodes do not exist until HyperShift makes them.
#
# Sizing is baked in here rather than taken from the site definition, because
# the ClusterInstance API has nowhere to put cores, memory or GPUs: NodeSpec
# describes hardware to be claimed, not hardware to be created. That matches how
# the toolbox already works -- GUEST_VM_CORES and friends in config/instance.env
# are fleet-wide, not per guest. A differently shaped guest is a second template
# set, which is the separation the operator is built around.
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ siteconfig_hcp_cluster_template }}
  namespace: {{ siteconfig_template_namespace }}
data:
  HostedCluster: |
{% raw %}
    apiVersion: hypershift.openshift.io/v1beta1
    kind: HostedCluster
    metadata:
      name: "{{ .Spec.ClusterName }}"
      namespace: "{{ .Spec.ClusterName }}"
      annotations:
        siteconfig.open-cluster-management.io/sync-wave: "1"
    spec:
      infraID: "{{ .Spec.ClusterName }}"
      release:
        image: "{{ .SpecialVars.ReleaseImage }}"
      pullSecret:
        name: "{{ .Spec.PullSecretRef.Name }}"
      # No sshKey. 'hcp create cluster kubevirt' is called without --ssh-key
      # today, so the guests have never carried one; adding it here would be a
      # change of behaviour smuggled in behind a change of mechanism.
{% endraw %}
      controllerAvailabilityPolicy: {{ guest_control_plane_availability }}
      infrastructureAvailabilityPolicy: {{ guest_infra_availability }}
      olmCatalogPlacement: management
      fips: false
{% raw %}
      etcd:
        managementType: Managed
        managed:
          storage:
            type: PersistentVolume
            persistentVolume:
              size: 8Gi
{% endraw %}
              storageClassName: {{ storage_class }}
{% raw %}
      secretEncryption:
        type: aescbc
        aescbc:
          activeKey:
            name: "{{ .Spec.ClusterName }}-etcd-encryption-key"
      networking:
        networkType: "{{ .Spec.NetworkType }}"
    {{ if .Spec.ClusterNetwork }}
        clusterNetwork:
    {{ .Spec.ClusterNetwork | toYaml | indent 6 }}
    {{ end }}
    {{ if .Spec.ServiceNetwork }}
        # Objects, not bare strings. AgentClusterInstall's serviceNetwork is a
        # list of CIDRs and the shipped assisted-installer template flattens to
        # match; HostedCluster's is a list of {cidr: ...}, and handing it the
        # flattened form fails server-side apply with
        # ".spec.networking.serviceNetwork[0]: expected map, got &{172.31.0.0/16}".
        serviceNetwork:
    {{ .Spec.ServiceNetwork | toYaml | indent 6 }}
    {{ end }}
      platform:
        type: KubeVirt
        kubevirt:
          # The guest's ingress domain is derived from the infra cluster's, so
          # the VMs do not need a DNS zone of their own.
          baseDomainPassthrough: true
          # What puts the worker VMs on the infra cluster instead of this hub.
          # The hub has no GPUs and no room for them.
          credentials:
            infraKubeConfigSecret:
              name: "{{ .Spec.ClusterName }}-infra-credentials"
              key: kubeconfig
{% endraw %}
            infraNamespace: {{ acm_infra_namespace }}
      # Every service on a NodePort, and none on a LoadBalancer or a Route.
      #
      # On platform:none in AWS a LoadBalancer Service stays <pending> forever,
      # and the Route strategy is no escape: HyperShift serves Route-strategy
      # services from a private router that it exposes with a LoadBalancer of
      # its own, which stays <pending> just the same. One Route-strategy service
      # left behind is enough to bring that router back.
      #
      # The address is a node of the *hosting* cluster the worker VMs can reach.
      # They run on the infra cluster and the control plane is here, so it is
      # this hub's own node address, across the peering connection.
      #
      # spec.services is immutable once the HostedCluster exists, which is why
      # it is set correctly here rather than patched afterwards.
      services:
        # The two a human touches move to the load balancer's public name when
        # the public entry point is on; the two only the worker VMs speak stay
        # on the hub's private address, which is what those VMs can reach.
        # Publishing all four publicly would send the VMs' own traffic out
        # through the internet and back rather than across the peering.
        - service: APIServer
          servicePublishingStrategy:
            type: NodePort
            nodePort:
{% if guest_public_control_plane %}
              address: {{ guest_public_address }}
              port: {{ guest_api_nodeport }}
{% else %}
              address: {{ guest_api_address }}
{% endif %}
        - service: OAuthServer
          servicePublishingStrategy:
            type: NodePort
            nodePort:
{% if guest_public_control_plane %}
              address: {{ guest_public_address }}
              port: {{ guest_oauth_nodeport }}
{% else %}
              address: {{ guest_api_address }}
{% endif %}
        - service: Ignition
          servicePublishingStrategy:
            type: NodePort
            nodePort:
              address: {{ guest_api_address }}
        - service: Konnectivity
          servicePublishingStrategy:
            type: NodePort
            nodePort:
              address: {{ guest_api_address }}
  NodePool: |
{% raw %}
    apiVersion: hypershift.openshift.io/v1beta1
    kind: NodePool
    metadata:
      name: "{{ .Spec.ClusterName }}"
      namespace: "{{ .Spec.ClusterName }}"
      annotations:
        siteconfig.open-cluster-management.io/sync-wave: "2"
        # HyperShift spreads a NodePool's VMs across the infra cluster either
        # way: without this it uses preferred pod anti-affinity, which only says
        # "somewhere else if you can" and will happily put two of three on one
        # node. With it, topology spread constraints with maxSkew 1, which asks
        # for as even a distribution as the node count allows.
        #
        # The annotation exists because switching an existing NodePool between
        # the two replaces every VM, so the controller will not do it unasked.
        # These NodePools are created with it from the start, so there is
        # nothing to replace.
        hypershift.openshift.io/nodepool-supports-kubevirt-topology-spread-constraints: "true"
    spec:
      clusterName: "{{ .Spec.ClusterName }}"
      arch: amd64
      release:
        image: "{{ .SpecialVars.ReleaseImage }}"
      # Day-1 machine configuration for the workers, as ConfigMaps in this
      # cluster's namespace on the hub. Written by the site definition, so the
      # name is predictable and the ConfigMap arrives with the rest of the
      # folder; a reference to one that does not exist leaves the NodePool
      # degraded rather than quietly unconfigured.
      config:
        - name: "{{ .Spec.ClusterName }}-chrony"
{% endraw %}
      replicas: {{ guest_nodepool_replicas }}
      management:
        # Replace rather than InPlace, and no auto-repair: a worker here is a VM
        # with a passed-through GPU, and replacing one returns the device to the
        # pool cleanly where repairing it in place would not.
        autoRepair: false
        upgradeType: Replace
      platform:
        type: KubeVirt
        kubevirt:
          attachDefaultNetwork: true
          networkInterfaceMultiqueue: Enable
          compute:
            cores: {{ guest_vm_cores }}
            memory: {{ guest_vm_memory }}
          rootVolume:
            type: Persistent
            persistent:
              size: {{ guest_vm_root_disk }}
              storageClass: {{ storage_class }}
{% if guest_gpus_per_node | int > 0 %}
          # Read from the infra cluster at run time, not guessed: the resource
          # name the GPU Operator advertises carries the device model.
          hostDevices:
            - deviceName: {{ gpu_resource_name }}
              count: {{ guest_gpus_per_node }}
{% endif %}
{% raw %}
  ManagedCluster: |
    apiVersion: cluster.open-cluster-management.io/v1
    kind: ManagedCluster
    metadata:
      name: "{{ .Spec.ClusterName }}"
      annotations:
        siteconfig.open-cluster-management.io/sync-wave: "3"
      labels:
        cloud: auto-detect
        vendor: auto-detect
        # The label a fleet-wide Placement selects on. Guests carry no name
        # label -- the operator does not set one -- so without this there is no
        # predicate that reaches both an imported cluster and a built one.
        tnf-toolbox-gp/fleet: "true"
    spec:
      hubAcceptsClient: true
  KlusterletAddonConfig: |
    apiVersion: agent.open-cluster-management.io/v1
    kind: KlusterletAddonConfig
    metadata:
      name: "{{ .Spec.ClusterName }}"
      namespace: "{{ .Spec.ClusterName }}"
      annotations:
        siteconfig.open-cluster-management.io/sync-wave: "3"
    spec:
      clusterName: "{{ .Spec.ClusterName }}"
      clusterNamespace: "{{ .Spec.ClusterName }}"
      applicationManager:
        enabled: false
      certPolicyController:
        enabled: false
      iamPolicyController:
        enabled: false
      policyController:
        enabled: true
      # On, for the same reason it is on for the infra cluster: the console's
      # per-cluster view -- node resources, GPU counts, the fleet virtualization
      # list -- is built from what this addon reports to the hub's Search. A
      # cluster without it is managed and healthy and reads as zero of
      # everything, which looks like a console fault rather than a missing
      # addon. The guest's GPUs are the whole point of the guest, so a fleet
      # view showing none of them is worse than the cost of running it.
      searchCollector:
        enabled: true
{% endraw %}
