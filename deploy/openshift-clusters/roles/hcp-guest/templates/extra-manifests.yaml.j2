#
# Ansible managed -- roles/hcp-guest/templates/extra-manifests.yaml.j2
#
# Install-time node configuration for {{ guest_name }}, referenced from the
# NodePool via spec.config.
#
# Deliberately not spec.extraManifestsRefs, which is what the all-VM profile
# uses. That field becomes the AgentClusterInstall's manifestsConfigMapRefs, and
# a hosted cluster has no AgentClusterInstall -- setting it here would be
# accepted by the ClusterInstance CRD and render into nothing at all. HyperShift
# carries day-1 machine configuration on the NodePool instead.
#
# The shape differs too: a NodePool config entry is a ConfigMap holding exactly
# one manifest under the key 'config', where the assisted installer's takes many
# keyed by filename. One ConfigMap per manifest is the cost of that.
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ guest_name }}-chrony
  namespace: {{ guest_name }}
  labels:
    # Backed up and restored with the rest of the site definition.
    cluster.open-cluster-management.io/backup: cluster-activation
data:
  config: |
    apiVersion: machineconfiguration.openshift.io/v1
    kind: MachineConfig
    metadata:
      name: {{ guest_chrony_machine_config_name }}
      labels:
        machineconfiguration.openshift.io/role: worker
    spec:
      config:
        ignition:
          version: 3.2.0
        storage:
          files:
            - path: /etc/chrony.conf
              mode: 420
              overwrite: true
              contents:
                source: data:text/plain;charset=utf-8;base64,{{ guest_chrony_conf | b64encode }}
